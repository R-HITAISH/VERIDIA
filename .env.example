# ── Core ─────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info

# ── Redis (used by BullMQ + run state store) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM providers ────────────────────────────────────────────────────
# Option A: Groq (FREE) — recommended
#   Sign up at https://console.groq.com → copy your API key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL_FAST=llama-3.1-8b-instant

# Option B: OpenAI — comment out OPENAI_BASE_URL above and use a real OpenAI key
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_FAST=gpt-4o-mini

# Option C: Anthropic (for planner/synthesis) — optional override
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MODEL_FAST=claude-haiku-4-20250514

# ── Tools ────────────────────────────────────────────────────────────
# Tavily web search (FREE tier) — https://app.tavily.com
TAVILY_API_KEY=
# Exa semantic search (optional) — https://exa.ai
EXA_API_KEY=
# GitHub token (optional, increases rate limits) — https://github.com/settings/tokens
GITHUB_TOKEN=
# SEC EDGAR requires a User-Agent identifying you (per SEC policy)
SEC_EDGAR_USER_AGENT="Veridia Diligence Engine contact@example.com"

# ── Delivery ─────────────────────────────────────────────────────────
# Slack incoming webhook (optional) — Slack App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── Webhook auth ─────────────────────────────────────────────────────
WEBHOOK_SHARED_SECRET=change-me

# ── Omium tracing (optional, +10% bonus) ─────────────────────────────
OMIUM_API_KEY=
OMIUM_PROJECT_ID=
OMIUM_ENDPOINT=https://api.omium.ai
