{
  "name": "veridia",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous multi-agent investment due-diligence engine. Webhook-driven, long-running, real tool calls, produces a professional PDF investment memo.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "demo": "tsx scripts/trigger-demo.ts",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@react-pdf/renderer": "^4.1.5",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "exa-js": "^1.4.10",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "nanoid": "^5.0.9",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
